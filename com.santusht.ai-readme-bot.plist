<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.santusht.ai-readme-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/santushtkotai/Desktop/bot/venv/bin/python</string>
        <string>/Users/santushtkotai/Desktop/bot/bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/santushtkotai/Desktop/bot</string>

    <!-- Auto-start on login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Keep alive if it crashes -->
    <key>KeepAlive</key>
    <true/>

    <!-- Redirect logs -->
    <key>StandardOutPath</key>
    <string>/Users/santushtkotai/Desktop/bot/data/bot.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/santushtkotai/Desktop/bot/data/bot_error.log</string>
</dict>
</plist>
